{
  "name": "zerodayhub",
  "version": "1.0.0",
  "private": true,
  "description": "ZeroDayHub - Vulnerability governance and semantic threat intelligence (MySQL + PostgreSQL/pgvector + Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
