digraph ER {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", nodesep=0.45, ranksep=1.1, splines=true, pad=0.3];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9, color="#455a7a", arrowsize=0.8];

  departments [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1f3a5f"><font color="white"><b>departments</b></font></td></tr>
    <tr><td align="left"><u>department_id</u> PK</td></tr>
    <tr><td align="left">name  UNIQUE</td></tr>
    <tr><td align="left">head_user_id  FK (nullable)</td></tr></table>>];

  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1f3a5f"><font color="white"><b>users</b></font></td></tr>
    <tr><td align="left"><u>user_id</u> PK</td></tr>
    <tr><td align="left">full_name</td></tr>
    <tr><td align="left">email  UNIQUE, CHECK</td></tr>
    <tr><td align="left">password_hash  CHECK bcrypt</td></tr>
    <tr><td align="left">role  ENUM(Security_Analyst,<br align="left"/>Asset_Owner, Admin)<br align="left"/></td></tr>
    <tr><td align="left">department_id  FK</td></tr>
    <tr><td align="left">is_active, last_login_at</td></tr></table>>];

  assets [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1f3a5f"><font color="white"><b>assets</b></font></td></tr>
    <tr><td align="left"><u>asset_id</u> PK</td></tr>
    <tr><td align="left">hostname  UNIQUE</td></tr>
    <tr><td align="left">ip_address  CHECK valid IP</td></tr>
    <tr><td align="left">environment, os_version</td></tr>
    <tr><td align="left">criticality</td></tr>
    <tr><td align="left">owner_id  FK</td></tr></table>>];

  asset_dependencies [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#5f3a1f"><font color="white"><b>asset_dependencies</b></font></td></tr>
    <tr><td align="left"><u>asset_id</u> PK, FK</td></tr>
    <tr><td align="left"><u>depends_on_asset_id</u> PK, FK</td></tr>
    <tr><td align="left">relationship  ENUM</td></tr></table>>];

  cwe_catalog [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1f3a5f"><font color="white"><b>cwe_catalog</b></font></td></tr>
    <tr><td align="left"><u>cwe_id</u> PK</td></tr>
    <tr><td align="left">name</td></tr></table>>];

  sla_policies [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1f3a5f"><font color="white"><b>sla_policies</b></font></td></tr>
    <tr><td align="left"><u>severity</u> PK</td></tr>
    <tr><td align="left">sla_days  CHECK &gt; 0</td></tr></table>>];

  cve_records [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#1f3a5f"><font color="white"><b>cve_records</b></font></td></tr>
    <tr><td align="left"><u>cve_id</u> PK  CHECK format</td></tr>
    <tr><td align="left">title  FULLTEXT</td></tr>
    <tr><td align="left">cwe_id  FK</td></tr>
    <tr><td align="left">cvss_score  CHECK 0-10</td></tr>
    <tr><td align="left">severity  FK (set by trigger)</td></tr>
    <tr><td align="left">published_date</td></tr>
    <tr><td align="left">vector_sync_status, is_retired</td></tr></table>>];

  vuln_tickets [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#7a1f2b"><font color="white"><b>vuln_tickets</b></font></td></tr>
    <tr><td align="left"><u>ticket_id</u> PK</td></tr>
    <tr><td align="left">asset_id  FK</td></tr>
    <tr><td align="left">cve_id  FK</td></tr>
    <tr><td align="left">assigned_analyst_id  FK</td></tr>
    <tr><td align="left">status  ENUM</td></tr>
    <tr><td align="left">sla_deadline, resolved_at</td></tr>
    <tr><td align="left">remediation_commit_hash  CHECK</td></tr>
    <tr><td align="left">UNIQUE (asset_id, cve_id)</td></tr></table>>];

  patch_verifications [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#7a1f2b"><font color="white"><b>patch_verifications</b></font></td></tr>
    <tr><td align="left"><u>verification_id</u> PK</td></tr>
    <tr><td align="left">ticket_id  FK</td></tr>
    <tr><td align="left">commit_hash</td></tr>
    <tr><td align="left">reviewer_id  FK</td></tr>
    <tr><td align="left">verdict  VERIFIED | REJECTED</td></tr>
    <tr><td align="left">notes, reviewed_at</td></tr></table>>];

  audit_logs [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#7a1f2b"><font color="white"><b>audit_logs</b></font> (append-only)</td></tr>
    <tr><td align="left"><u>log_id</u> PK</td></tr>
    <tr><td align="left">ticket_id  FK</td></tr>
    <tr><td align="left">actor_user_id  FK (nullable = SYSTEM)</td></tr>
    <tr><td align="left">action_type, log_message</td></tr>
    <tr><td align="left">logged_at (ms)</td></tr></table>>];

  pgvec [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#2e6b3a"><font color="white"><b>PostgreSQL: cve_threat_vectors</b></font></td></tr>
    <tr><td align="left"><u>cve_id</u> PK  (logical link to MySQL)</td></tr>
    <tr><td align="left">advisory_text, exploit_summary,<br align="left"/>remediation_playbook<br align="left"/></td></tr>
    <tr><td align="left">metadata JSONB</td></tr>
    <tr><td align="left"><b>embedding vector(384)</b>  HNSW cosine</td></tr>
    <tr><td align="left">embedding_model, content_hash</td></tr>
    <tr><td align="left">search_tsv (generated)</td></tr></table>>];

  // relationships (crow's foot: arrowhead at the many side)
  departments -> users        [arrowhead=crow, taillabel="1", headlabel="N", label="employs"];
  users -> departments        [style=dashed, arrowhead=none, arrowtail=odot, dir=back, label="heads (0..1)", constraint=false];
  users -> assets             [arrowhead=crow, taillabel="1", headlabel="N", label="owns"];
  assets -> asset_dependencies [arrowhead=crow, taillabel="1", headlabel="N", label="depends on"];
  asset_dependencies -> assets [arrowhead=crow, style=dashed, label="(target)", constraint=false];
  cwe_catalog -> cve_records   [arrowhead=crow, taillabel="1", headlabel="N", label="classifies"];
  sla_policies -> cve_records  [arrowhead=crow, taillabel="1", headlabel="N", label="severity"];
  assets -> vuln_tickets       [arrowhead=crow, taillabel="1", headlabel="N", label="affected by"];
  cve_records -> vuln_tickets  [arrowhead=crow, taillabel="1", headlabel="N", label="instance of"];
  users -> vuln_tickets        [arrowhead=crow, taillabel="1", headlabel="N", label="assigned to", constraint=false];
  vuln_tickets -> patch_verifications [arrowhead=crow, taillabel="1", headlabel="N", label="verified by"];
  vuln_tickets -> audit_logs   [arrowhead=crow, taillabel="1", headlabel="N", label="logged in"];
  users -> audit_logs          [arrowhead=crow, style=dashed, label="acts", constraint=false];
  users -> patch_verifications [arrowhead=crow, style=dashed, label="reviews", constraint=false];
  cve_records -> pgvec         [style=dotted, color="#2e6b3a", arrowhead=none, penwidth=2, label="1 : 0..1\n(logical, by cve_id)"];
}
