# Copy to .env.local and fill in. .env.local is git-ignored; never commit real secrets.

# ---------- MySQL (relational core) --------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=zerodayhub_db
# One login per RBAC role. init-db creates these accounts with these passwords.
MYSQL_AUTH_USER=zdh_auth
MYSQL_AUTH_PASSWORD=change-me-auth
MYSQL_ANALYST_USER=zdh_analyst
MYSQL_ANALYST_PASSWORD=change-me-analyst
MYSQL_OWNER_USER=zdh_owner
MYSQL_OWNER_PASSWORD=change-me-owner
MYSQL_ADMIN_USER=zdh_admin
MYSQL_ADMIN_PASSWORD=change-me-admin
# Host part of the MySQL accounts (use % if the DB is on another machine)
APP_HOST=localhost
# Setup-only account used by `npm run db:init` (needs CREATE/GRANT rights, e.g. root)
MYSQL_SETUP_USER=root
MYSQL_SETUP_PASSWORD=

# ---------- PostgreSQL + pgvector (semantic store) ------------------------
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=zerodayhub_vectors
PG_READER_USER=zdh_vec_reader
PG_READER_PASSWORD=change-me-reader
PG_WRITER_USER=zdh_vec_writer
PG_WRITER_PASSWORD=change-me-writer
# Setup-only superuser used by `npm run db:init`
PG_SETUP_USER=postgres
PG_SETUP_PASSWORD=

# ---------- Embeddings ---------------------------------------------------
# transformers = real sentence embeddings (downloads the model on first use, ~90 MB)
# hash         = offline lexical fallback (no download; weaker semantics, fine for tests)
EMBEDDING_PROVIDER=transformers
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ---------- NextAuth -----------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
SHOW_DEMO_ACCOUNTS=true
